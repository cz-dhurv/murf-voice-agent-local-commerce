# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Outbound calling (Day 6) — Twilio Elastic SIP Trunk + LiveKit SIP
# Only needed to PLACE calls; inbound/browser calls work without any of this.
# 1. Create a Twilio Elastic SIP Trunk with a Termination URI + Credential List.
# 2. Fill the TWILIO_* values below in .env.local (never commit real secrets).
# 3. Run:  python scripts/setup_outbound_trunk.py  → prints the ST_ trunk id.
# 4. Put that id in LIVEKIT_SIP_OUTBOUND_TRUNK_ID, then scripts/call_customer.py.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_SIP_TERM_URI=your-trunk.pstn.twilio.com
TWILIO_SIP_USERNAME=your_trunk_credential_username
TWILIO_SIP_PASSWORD=your_trunk_credential_password

# Filled in by scripts/setup_outbound_trunk.py (leave blank until then)
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
